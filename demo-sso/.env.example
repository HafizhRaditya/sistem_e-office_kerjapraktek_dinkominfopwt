PORT=9000

# Issuer realm Keycloak, bukan URL admin console dan bukan endpoint /auth.
OIDC_ISSUER=https://account.dev.banyumaskab.go.id/realms/EOffice

# Client BARU khusus aplikasi demo. Jangan memakai client portal E-Office.
OIDC_CLIENT_ID=eoffice-sso-demo
OIDC_CLIENT_SECRET=

# Harus sama persis dengan pengaturan client di Keycloak.
OIDC_REDIRECT_URI=http://127.0.0.1:9000/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:9000/logged-out

# Buat nilai acak panjang, misalnya:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
